{
  "name": "nexuss-ai",
  "private": false,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:frontend": "vite build",
    "start": "node src/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "build:android": "node build-and-release.cjs",
    "cap:build": "npm run build && npx cap sync",
    "build:capacitor": "npm run cap:build && cd android && bash ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../NexussAI_Capacitor.apk"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@capacitor/android": "5.7.8",
    "@capacitor/cli": "5.7.8",
    "@capacitor/core": "5.7.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "expo": "^57.0.24",
    "expo-blur": "^57.0.3",
    "expo-clipboard": "^57.0.2",
    "expo-linear-gradient": "^57.0.2",
    "expo-status-bar": "^57.0.1",
    "expo-updates": "^57.0.23",
    "lucide-react": "^0.546.0",
    "lucide-react-native": "^1.47.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
