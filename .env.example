# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"

# NAR_BASE_URL: The Nexuss AI Router deployment that serves inference.
NAR_BASE_URL="https://omniouter-vercel.vercel.app"

# NAR_API_KEY: The master key configured on that deployment.
NAR_API_KEY="MY_NAR_API_KEY"

# NAR_MODEL: "auto" lets the router pick a healthy model per request.
NAR_MODEL="auto"

# NAR_TIMEOUT_MS: Per-request deadline before the call is abandoned.
NAR_TIMEOUT_MS="45000"

# FILESYSTEM_KIT_URL: Workspace backend the agent's file tools run against.
FILESYSTEM_KIT_URL="https://filesystem-kit.wasmer.app"

# Legacy names, still read as fallbacks by server.ts.
# OMNIROUTE_BASE_URL="https://omniouter-vercel.vercel.app"
# OMNIROUTE_AI_API_KEY="MY_OMNIROUTE_AI_API_KEY"
